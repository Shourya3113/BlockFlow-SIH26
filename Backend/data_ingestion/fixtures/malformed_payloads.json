        "DISCONNECTION": "Y",
        "STATUTORY_FORM": "NONE"
      }
    },
    {
      "case_id": "METRES_EXPORTED_AS_CHAINAGE",
      "rule": "CHAINAGE_UNIT_COERCION",
      "expect": "ACCEPT",
      "why": "Some CRIS columns export metres; 20400 M must coerce to km 20.40 rather than being rejected.",
