        "REQUISITION_NO": "BAD-013",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "twenty",
        "KM_TO": "21.20",
        "TRACK": "DN_FAST",
        "DURATION_MINS": "120"
      }
    },
    {
      "case_id": "DEPARTMENT_MISSING",
      "rule": "DEPT_ENUM",
      "expect": "REJECT",
      "why": "No department/directorate and the feed does not declare a silo.",
      "payload": {
        "REQUISITION_NO": "BAD-014",
        "KM_FROM": "21.00",
        "KM_TO": "21.20",
        "TRACK": "DN_FAST",
        "DURATION_MINS": "60"
      }
    },
    {
      "case_id": "ACI_OUT_OF_RANGE",
      "rule": "ACI_RANGE",
      "expect": "REJECT",
      "why": "ACI is defined 0-100; 150 means the score was computed by a broken formula.",
      "payload": {
        "REQUISITION_NO": "BAD-015",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "21.00",
        "KM_TO": "21.20",
        "TRACK": "DN_FAST",
        "DURATION_MINS": "60",
        "ACI_SCORE": 150
      }
    },
    {
      "case_id": "HOTSPOT_IMPLAUSIBLE",
      "rule": "HOTSPOT_RANGE",
      "expect": "REJECT",
      "why": "Thermovision sensor error: 612 C on a contact wire is physically impossible.",
      "payload": {
        "ASSET_ID": "BAD-016",
        "WING": "TRD",
        "CHAINAGE_FROM": "21.00",
        "CHAINAGE_TO": "21.30",
        "TRACK": "UP_FAST",
        "DURATION": "60",
        "HOTSPOT_TEMP_C": 612.0
      }
    },
    {
      "case_id": "NOT_OBJECT_RECORD",
      "rule": "RECORD_TYPE",
      "expect": "REJECT",
      "why": "A bare string arrived where a requisition object was expected.",
      "payload": "TMS-ENG-9999|19.4|21.2|DN_FAST"
    },
    {
      "case_id": "NULL_REQUISITION",
      "rule": "RECORD_TYPE",
      "expect": "REJECT",
      "why": "Null row from a LEFT JOIN in the CRIS extract.",
      "payload": null
    },
    {
      "case_id": "SPEED_RESTRICTION_ABOVE_LINE_SPEED",
      "rule": "IRPWM_268B_SPEED_RESTRICTION",
      "expect": "ACCEPT_BUT_FLAGGED",
      "why": "Structurally valid, but a 145 km/h PSR exceeds the 110 km/h permissible section speed - the safety engine must flag it rather than the solver.",
      "payload": {
        "REQUISITION_NO": "WARN-001",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "19.00",
        "KM_TO": "19.60",
        "TRACK": "DN_FAST",
        "DURATION_MINS": "120",
        "SEVERITY": "URGENT",
        "PSR_SPEED": 145,
        "OHE_REQUIRED": "Y",
        "TRAFFIC_BLOCK": "Y"
      }
    },
    {
      "case_id": "POWER_BLOCK_WITHOUT_TRAFFIC_BLOCK",
      "rule": "ACTM_203_POWER_ISOLATION",
      "expect": "ACCEPT_BUT_FLAGGED",
      "why": "The DUTY sheet asks for a 25 kV isolation but no traffic block; LOTO cannot be assured, so the guardrail must block it before the simplex solver sees it.",
      "payload": {
        "ASSET_ID": "WARN-002",
        "WING": "TRD",
        "CHAINAGE_FROM": "33.00",
        "CHAINAGE_TO": "33.40",
        "TRACK": "DN_SLOW",
        "DURATION": "60",
        "PRIORITY": "CRITICAL",
