    {
      "case_id": "BOOLEAN_SPELLINGS",
      "rule": "BOOLEAN_COERCION",
      "expect": "ACCEPT",
      "why": "Booleans arrive as Y / YES / 1 / TRUE depending on the silo; all must coerce.",
      "payload": {
        "REQ_NO": "OK-003",
        "DEPT": "S&T",
