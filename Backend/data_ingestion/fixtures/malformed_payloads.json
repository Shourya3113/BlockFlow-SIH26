{
  "feed_id": "STRESS-MALFORMED-001",
  "description": "Malformed / hostile CRIS payload corpus used to prove the ingestion layer quarantines bad data instead of leaking it into the HiGHS simplex solver. Each case declares the outcome the contract must produce: REJECT (never reaches the optimizer) or ACCEPT_BUT_FLAGGED (syntactically valid, but the statutory safety invariant must catch it).",
  "expected_contract": "[asset_id, dept, km_start, km_end, aci]",
  "cases": [
    {
      "case_id": "KM_END_BEYOND_CORRIDOR",
      "rule": "CORRIDOR_BOUNDARY",
      "expect": "REJECT",
      "why": "Virar is km 59.980; chainage 62.40 lies beyond the surveyed corridor.",
      "payload": {
        "REQUISITION_NO": "BAD-001",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "58.50",
        "KM_TO": "62.40",
        "TRACK": "UP_FAST",
        "DURATION_MINS": "90",
        "SEVERITY": "URGENT"
      }
    },
    {
      "case_id": "KM_START_NEGATIVE",
      "rule": "CORRIDOR_BOUNDARY",
      "expect": "REJECT",
      "why": "Negative chainage - datum error in the CRIS export.",
      "payload": {
        "REQUISITION_NO": "BAD-002",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "-2.50",
        "KM_TO": "1.20",
        "TRACK": "DN_SLOW",
        "DURATION_MINS": "60",
        "SEVERITY": "ROUTINE"
      }
    },
    {
      "case_id": "INVERTED_CHAINAGE",
      "rule": "CHAINAGE_ORDER",
      "expect": "REJECT",
      "why": "km_start 25.00 > km_end 18.00 - the possession would run backwards.",
      "payload": {
        "REQ_NO": "BAD-003",
        "DEPT": "S&T",
        "CHAINAGE_FROM": "25.00",
        "CHAINAGE_TO": "18.00",
        "RUNNING_LINE": "UP_FAST",
        "MINUTES": "60",
        "SEVERITY": "URGENT",
        "DISCONNECTION": "Y"
      }
    },
    {
      "case_id": "SPAN_TOO_LONG",
      "rule": "SINGLE_POSSESSION_SPAN",
      "expect": "REJECT",
      "why": "A 35 km single possession cannot be a legal block; must be split.",
      "payload": {
        "ASSET_ID": "BAD-004",
        "WING": "TRD",
        "CHAINAGE_FROM": "5.00",
        "CHAINAGE_TO": "40.00",
        "TRACK": "DN_FAST",
        "DURATION": "120",
        "PRIORITY": "HIGH"
      }
    },
    {
      "case_id": "UNKNOWN_DEPARTMENT",
      "rule": "DEPT_ENUM",
      "expect": "REJECT",
      "why": "MECHANICAL is not one of the three directorates the optimizer schedules.",
      "payload": {
        "REQUISITION_NO": "BAD-005",
        "DIRECTORATE": "MECHANICAL",
        "KM_FROM": "12.00",
        "KM_TO": "12.40",
        "TRACK": "UP_SLOW",
        "DURATION_MINS": "60"
      }
    },
    {
      "case_id": "UNKNOWN_RUNNING_LINE",
      "rule": "LINE_ENUM",
      "expect": "REJECT",
      "why": "Corridor has 4 lines (UP/DN FAST/SLOW); DN_UP does not exist.",
      "payload": {
        "REQUISITION_NO": "BAD-006",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "12.00",
        "KM_TO": "12.40",
        "TRACK": "DN_UP",
        "DURATION_MINS": "60"
      }
    },
    {
      "case_id": "ZERO_DURATION",
      "rule": "POSSESSION_DURATION",
      "expect": "REJECT",
      "why": "Zero-minute possession is a data-entry stub, not a schedulable block.",
      "payload": {
        "REQUISITION_NO": "BAD-007",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "12.00",
        "KM_TO": "12.40",
        "TRACK": "UP_FAST",
        "DURATION_MINS": "0"
      }
    },
    {
      "case_id": "UNPARSEABLE_DURATION",
      "rule": "DURATION_ENCODING",
      "expect": "REJECT",
      "why": "Free-text duration from a scanned paper requisition.",
      "payload": {
        "REQ_NO": "BAD-008",
        "DEPT": "S&T",
        "CHAINAGE_FROM": "30.00",
        "CHAINAGE_TO": "30.20",
        "RUNNING_LINE": "DN_SLOW",
        "MINUTES": "till the block is over"
      }
    },
    {
      "case_id": "URGENCY_OVER_480",
      "rule": "POSSESSION_DURATION",
      "expect": "REJECT",
      "why": "A 9-hour possession exceeds the maximum single block window.",
      "payload": {
        "ASSET_ID": "BAD-009",
        "WING": "TRD",
        "CHAINAGE_FROM": "20.00",
        "CHAINAGE_TO": "21.00",
        "TRACK": "UP_FAST",
        "DURATION": "540"
      }
    },
    {
      "case_id": "MISSING_ASSET_ID",
      "rule": "ASSET_ID_REQUIRED",
      "expect": "REJECT",
      "why": "No requisition key - the asset cannot be traced back to a keeper.",
      "payload": {
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "15.00",
        "KM_TO": "15.30",
        "TRACK": "UP_SLOW",
        "DURATION_MINS": "60"
      }
    },
    {
      "case_id": "EMPTY_ASSET_ID",
      "rule": "ASSET_ID_REQUIRED",
      "expect": "REJECT",
      "why": "Whitespace-only asset id from a truncated CSV export.",
      "payload": {
        "REQUISITION_NO": "   ",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "15.00",
        "KM_TO": "15.30",
        "TRACK": "UP_SLOW",
        "DURATION_MINS": "60"
      }
    },
    {
      "case_id": "ASSET_ID_ILLEGAL_CHARS",
      "rule": "ASSET_ID_FORMAT",
      "expect": "REJECT",
      "why": "SQL-ish junk inside the requisition key must never be echoed downstream.",
      "payload": {
        "REQUISITION_NO": "'; DROP TABLE assets; --",
        "DIRECTORATE": "ENGINEERING",
        "KM_FROM": "15.00",
        "KM_TO": "15.30",
        "TRACK": "UP_SLOW",
        "DURATION_MINS": "60"
      }
    },
    {
      "case_id": "NON_NUMERIC_CHAINAGE",
      "rule": "CHAINAGE_NUMERIC",
      "expect": "REJECT",
      "why": "Chainage exported as a word instead of a number.",
